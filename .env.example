# Copy this file to .env and enter your own Brevo SMTP credentials.
# Find the SMTP login and SMTP key in Brevo under SMTP & API > SMTP.
# The sender must be verified in your Brevo account.
NUXT_BREVO_SMTP_USER=
NUXT_BREVO_SMTP_KEY=
NUXT_BREVO_SENDER_EMAIL=info@enisshala-gartenbau.de
NUXT_BREVO_SMTP_PORT=587
NUXT_CONTACT_RECIPIENT=info@enisshala-gartenbau.de
